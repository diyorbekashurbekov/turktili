# Copy to .env.local and fill in. NEVER put real keys in this file.

# Google Gemini (server-side only; never sent to the browser)
GEMINI_API_KEY=
# Optional model overrides (the admin panel can also change them)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Turkish TTS voices: female (default) and male (second dialogue speaker)
GEMINI_TTS_VOICE_F=Kore
GEMINI_TTS_VOICE_M=Charon
# Daily spend cap in USD (estimated from token usage)
AI_DAILY_BUDGET_USD=5

# Comma-separated emails that get the admin panel after registering
ADMIN_EMAILS=
# Where the SQLite database, TTS cache and uploaded audio live (local / Railway)
DATA_DIR=./data

# Vercel (serverless, no shared disk): a Turso database and a private Vercel Blob store
# libsql://<db>-<org>.turso.io  — leave empty to use the local SQLite file
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Added automatically when a Blob store is connected to the Vercel project
BLOB_READ_WRITE_TOKEN=
# Original page scans (p001.jpg …) — only serve with publisher permission
BOOK_PAGES_DIR=
BOOK_PAGES_AUTHORIZED=false
